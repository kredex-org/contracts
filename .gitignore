# --- Rust / Cargo build output ------------------------------------------------
/target/
**/target/
**/*.rs.bk

# Cargo.lock IS committed on purpose: contracts are binaries and builds must be
# reproducible.

# --- Soroban / Stellar --------------------------------------------------------
*.wasm
*.optimized.wasm
.stellar/
.soroban/
# Auto-generated by `cargo test`; regenerated on every run
**/test_snapshots/

# --- Secrets & local config (NEVER commit) ------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.secret
secrets/
# Local deployment outputs that may contain account details
deployed-contracts*.json
.deployed-*

# --- Logs ---------------------------------------------------------------------
*.log

# --- Editors / IDEs -----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo
*~

# --- OS files -----------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
